# Copy to .env (or export in your shell). All optional.
MODD_MODEL=llama3.1:8b          # any Ollama model with tool support (qwen2.5:7b, llama3.2:3b on the Pi)
MODD_OLLAMA_URL=http://localhost:11434
MODD_HOME=~/.modd                # where modd.db lives
MODD_NAME=Modd
MODD_USER=boss
MODD_WHISPER_MODEL=base.en       # tiny.en on the Pi
MODD_PIPER_VOICE=                # path to a Piper .onnx voice, e.g. en_US-ryan-medium.onnx
MODD_API_HOST=127.0.0.1          # 0.0.0.0 to let the ESP32 reach it on your LAN
MODD_API_PORT=8765
MODD_API_TOKEN=                  # set this before exposing the API on your network

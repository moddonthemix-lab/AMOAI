# --- Modd core ---
MODD_DB_PATH=./data/modd.db
MODD_OWNER_NAME=Modd
MODD_ASSISTANT_NAME=Modd
MODD_TIMEZONE=America/New_York
# Shared secret for the API (Open WebUI connection key, ESP32 device, CLI). Change it!
MODD_API_KEY=change-me

# --- Ollama (local models) ---
OLLAMA_URL=http://localhost:11434
MODD_CHAT_MODEL=llama3.1:8b
MODD_EMBED_MODEL=nomic-embed-text
# Smaller model for background learning jobs (fact extraction / weekly reflection)
MODD_FAST_MODEL=llama3.2:3b

# --- Voice ---
MODD_WHISPER_MODEL=base.en
MODD_PIPER_VOICE=./models/piper/en_US-lessac-medium.onnx

# --- Notifications (optional, self-hosted ntfy.sh) ---
MODD_NTFY_URL=
MODD_NTFY_TOPIC=modd
MODD_MONTHLY_REVENUE_TARGET=10000

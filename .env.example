# --- AMO core ---
AMO_DB_PATH=./data/amo.db
AMO_OWNER_NAME=Modd
AMO_ASSISTANT_NAME=AMO
AMO_TIMEZONE=America/New_York
# Shared secret for the API (Open WebUI connection key, ESP32 device, CLI). Change it!
AMO_API_KEY=change-me
# Requests from this Mac itself (localhost) skip the key. Set to 0 to always require it.
AMO_TRUST_LOCALHOST=1

# --- Ollama (local models) ---
OLLAMA_URL=http://localhost:11434
# Docker only: where the containers reach Ollama (default: native Ollama on your Mac)
# AMO_DOCKER_OLLAMA_URL=http://host.docker.internal:11434
AMO_CHAT_MODEL=llama3.1:8b
AMO_EMBED_MODEL=nomic-embed-text
# Smaller model for background learning jobs (fact extraction / weekly reflection)
AMO_FAST_MODEL=llama3.2:3b
# Context window (tokens), how long the model stays loaded, and "thinking" for qwen3/gemma4 (slow on CPU)
AMO_NUM_CTX=8192
# -1 keeps the model loaded so AMO answers fast (30m frees the memory when idle)
AMO_KEEP_ALIVE=-1
AMO_THINK=0

# --- Eyes (camera + local vision model; `amo setup-vision` downloads the model) ---
# Camera: 0 = webcam/USB camera, pi = Raspberry Pi camera, http://<ip>/capture = ESP32-CAM, none = off
AMO_CAMERA=0
# moondream is small and quick (good for a Pi); gemma3:4b sees better but is slower
AMO_VISION_MODEL=moondream

# Your documents for AMO to learn from (PDF, docx, txt, md, csv, html…)
AMO_KNOWLEDGE_DIR=~/Documents/AMO Knowledge

# --- Coding (local code model; `amo setup-coder` downloads it) ---
AMO_CODER_MODEL=qwen2.5-coder:3b
# Folders AMO may read and fix code in (comma-separated)
AMO_CODE_DIRS=~/Projects,~/Developer,~/code,~/Desktop
# AMO fixes its own simple bugs when all its tests pass (0 = off)
AMO_SELF_REPAIR=1

# --- Voice ---
# AMO's voice: amo (BMO voice — default) | obadiah (clean British) | computer (Obadiah + robotic edge)
# | jarvis | british-female | default, a Piper voice name (en_GB-alan-medium), or say:Daniel
AMO_VOICE=amo
# Optional tweaks: speed (1 = normal), pitch in semitones (-3 deeper … +3 higher), robot 0–1
AMO_VOICE_RATE=
AMO_VOICE_PITCH=
AMO_VOICE_ROBOT=
# How AMO talks: mood (adapts: chill/hype/steady/firm/quiet) | chill | computer (dry British wit) | jarvis
# | default. Empty = matches the voice (amo → mood)
AMO_PERSONALITY=
AMO_WHISPER_MODEL=base.en
# What AMO says while it works on an answer (phrases separated by |). AMO_ACKS=0 turns them off.
AMO_ACKS=1
AMO_ACK_THINK=Okay, let me think.|Let me think.|One moment.
AMO_ACK_ACTION=Got it.|I'll work on that now.|On it.
# Said if the answer is still coming after AMO_ACK_STILL_AFTER seconds
AMO_ACK_STILL=Still working on it.|Almost there.
AMO_ACK_STILL_AFTER=7
# Pause between sentences (seconds) and loudness (0.05 quiet … 0.15 loud)
AMO_VOICE_PAUSE=0.28
AMO_VOICE_LOUDNESS=0.1
# AMO speaking up on its own (watchlist alerts, reminders, brief, check-in) — never in quiet hours
AMO_PROACTIVE=1
AMO_QUIET_HOURS=22-8
# Morning brief: your city for weather + severe-weather alerts (blank = guessed once from your IP),
# °F/°C, and your calendars' private iCal links, comma-separated (iCloud webcal:// or Google secret address)
AMO_LOCATION=
AMO_TEMP_UNIT=F
AMO_CALENDAR_URLS=
AMO_CHECKIN_HOUR=21
# Speak while thinking. Interrupt AMO by starting with "No, I said…", "You misheard me", "Stop", "Wait"
AMO_STREAM_SPEECH=1
AMO_BARGE_IN=1
# Let a body device on your Wi-Fi reach this Mac (set by `amo lan on`)
AMO_LAN=0
# Wake-word engine: whisper (Mac default) | vosk (light, for a Pi: amo setup-wake vosk) | openwakeword
# (trained model — see docs/WAKE_WORD.md)
AMO_WAKE_ENGINE=whisper
AMO_VOSK_MODEL=./models/vosk/vosk-model-small-en-us-0.15
AMO_OWW_MODEL=./models/wake/hey_amo.onnx
AMO_OWW_THRESHOLD=0.5
# Wake word ("Hey AMO"): tiny model for spotting the phrase, mic sensitivity (2 = picks up quiet
# speech, 5 = needs you closer), extra spellings Whisper might use for the name
AMO_WAKE_MODEL=tiny.en
AMO_WAKE_SENSITIVITY=2
# Seconds of silence that mean you're done talking (raise to 1.2 if AMO cuts you off mid-thought)
AMO_END_SILENCE=0.9
AMO_WAKE_WORDS=
AMO_PIPER_VOICE=./models/piper/voice.onnx

# --- Backups --- (blank = iCloud Drive/AMO Backups if available, else ./backups)
AMO_BACKUP_DIR=

# --- Web search ---
# Blank = DuckDuckGo (no key needed). Or a self-hosted SearXNG for fully private search:
AMO_SEARXNG_URL=

# --- Notifications (optional, self-hosted ntfy.sh) ---
AMO_NTFY_URL=
AMO_NTFY_TOPIC=amo
AMO_MONTHLY_REVENUE_TARGET=10000

# AMO speaks alerts, hub news and reminders out loud through the Mac's speakers on his own, with no
# page open (quiet hours respected). On by default on a Mac; 0 turns it off.
AMO_SPEAK_ALOUD=1

# --- The Family Hub (optional) — see docs/FAMILY_HUB.md ---
# With HUB_URL + HUB_TOKEN set, `amo serve` joins the hub: answers questions, does tasks, tells you news.
# AMO_HUB=0 keeps the token (for cloud budgets) but turns the connector off.
AMO_HUB=1

# --- Cloud AI (optional) — the Family Hub's shared brain; see docs/CLOUD_AI.md ---
# Off unless all of these are set. Only answers that need no tools go to the cloud (chat, advice,
# coding help); saves, lookups, charts and your data stay local. The hub sets the monthly budget.
CLOUD_FOR_PRIVATE_CHATS=false
ANTHROPIC_API_KEY=
HUB_URL=http://192.168.1.208:8770
HUB_TOKEN=
# "big job: …" / "think hard about …" → Claude Opus (pricier)
AMO_CLOUD_BIG=false
